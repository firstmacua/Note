{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile representation in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id"]
    },
    "Note": {
      "title": "Note",
      "description": "User or public guest note",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "authorName": { "type": "string" },
        "authorId": { "type": "string" },
        "isPinned": { "type": "boolean" },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "title", "content", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "Note",
      "description": "User's private notes"
    },
    "/public_notes/{noteId}": {
      "schema": "Note",
      "description": "Public notes visible to everyone and editable/creatable by guests"
    }
  }
}
