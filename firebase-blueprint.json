{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile representation in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id"]
    },
    "Note": {
      "title": "Note",
      "description": "User note with cross-device sync",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "color": { "type": "string" },
        "category": { "type": "string" },
        "isPinned": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "content", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "Note",
      "description": "User's private notes synced across devices"
    }
  }
}
